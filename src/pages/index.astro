---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import { content as c } from '../content';

// Inline icon set (Lucide-style). Decorative icons are aria-hidden in markup.
const I: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  star: '<path d="M12 2l3 6.3 6.9 1-5 4.8 1.2 6.9L12 17.8 5.9 21l1.2-6.9-5-4.8 6.9-1z"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  sparkles: '<path d="M12 3l1.8 4.7L18.5 9l-4.7 1.8L12 15l-1.8-4.2L5.5 9l4.7-1.3z"/><path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8z"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v6h-6"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  zap: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2z"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  shield: '<path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="m9 12 2 2 4-4"/>',
  link: '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  home: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  layers: '<path d="m12 2 9 5-9 5-9-5z"/><path d="m3 12 9 5 9-5"/>',
};
const intIcon: Record<string, string> = { Jobber: I.briefcase, ServiceTitan: I.bolt, 'Housecall Pro': I.home };
const ic = (k: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[k] ?? I.sparkles}</svg>`;
const mark = `<svg class="mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><defs><linearGradient id="g" x1="0" y1="0" x2="32" y2="32"><stop stop-color="#8b8cff"/><stop offset="1" stop-color="#43c4ff"/></linearGradient></defs><rect width="32" height="32" rx="9" fill="url(#g)"/><path d="M9 20.5 15 9l3.2 6.2L22 11" stroke="#0a0b12" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<Base path="/">
  <header class="hdr">
    <div class="wrap hdr-inner">
      <a class="brand" href="/" aria-label={`${c.brand} home`}><Fragment set:html={mark} />{c.brand}</a>
      <a class="hdr-cta" href="#waitlist">{c.navCta}</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="badge rise"><span class="dot"></span>{c.badge}</span>
          <h1 class="rise d1">{c.h1a}<span class="grad">{c.h1grad}</span>{c.h1b}</h1>
          <p class="hero-sub rise d2">{c.sub}</p>
          <div class="hero-actions rise d2">
            <a class="btn btn-primary" href="#waitlist">{c.navCta}</a>
            <a class="btn btn-ghost" href="#how">See how it works</a>
          </div>
          <p class="hero-trust rise d3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{c.trust}</p>
        </div>

        <div class="mock rise d2" aria-hidden="true">
          <div class="mock-frame">
            <div class="mock-bar"><i></i><i></i><i></i><span class="url">{c.domain}</span></div>
            <div class="mock-body">
              <div class="mock-hero"><div class="l1"></div><div class="l2"></div><span class="pill"></span></div>
              <div class="mock-row">
                <div class="mock-card"><div class="ic"><Fragment set:html={ic(c.mock[0])} /></div><div class="ml1"></div><div class="ml2"></div></div>
                <div class="mock-card"><div class="ic"><Fragment set:html={ic(c.mock[1])} /></div><div class="ml1"></div><div class="ml2"></div></div>
                <div class="mock-card"><div class="ic"><Fragment set:html={ic(c.mock[2])} /></div><div class="ml1"></div><div class="ml2"></div></div>
              </div>
              <div class="mock-stat"><span class="k">{c.mockStat}</span><span class="v up">Live</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INTEGRATION STRIP -->
    <section class="strip"><div class="wrap">
      <p>Built to work with the software you already run</p>
      <div class="strip-row">
        <span class="chip"><Fragment set:html={ic('briefcase')} />Jobber</span>
        <span class="chip"><Fragment set:html={ic('bolt')} />ServiceTitan</span>
        <span class="chip"><Fragment set:html={ic('home')} />Housecall Pro</span>
        <span class="chip"><Fragment set:html={ic('layers')} />+ more</span>
      </div>
    </div></section>

    <!-- FEATURES -->
    <section class="sec" id="how"><div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{c.featHead.eyebrow}</span>
        <h2>{c.featHead.title}</h2>
        <p>{c.featHead.sub}</p>
      </div>
      <div class="cards">
        {c.features.map((f) => (
          <article class="card">
            <div class="ic"><Fragment set:html={ic(f.icon)} /></div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div></section>

    <!-- INTEGRATIONS -->
    <section class="sec" style="padding-top:0"><div class="wrap split">
      <div>
        <span class="eyebrow">Integrations in development</span>
        <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-top:12px">{c.intsHead.title}</h2>
        <p style="color:var(--fg-muted);margin-top:14px;font-size:1.05rem">{c.intsHead.sub}</p>
      </div>
      <div class="ints">
        {c.ints.map((it) => (
          <div class="int">
            <div class="ic"><Fragment set:html={`<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>${intIcon[it.brand] ?? I.link}</svg>`} /></div>
            <div><h3>{it.brand}</h3><p>{it.body}</p></div>
          </div>
        ))}
      </div>
    </div></section>

    <!-- CTA + FORM -->
    <section class="cta" id="waitlist"><div class="wrap"><div class="cta-card"><div class="cta-grid">
      <div>
        <span class="eyebrow">Early access</span>
        <h2 style="margin-top:12px">{c.ctaTitle}</h2>
        <p>{c.ctaSub}</p>
        <ul class="cta-list">
          {c.ctaList.map((li) => (<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{li}</li>))}
        </ul>
      </div>
      <div class="form-card">
        <p class="fc-title">Join the early access list</p>
        <Waitlist id="cta" />
      </div>
    </div></div></div></section>
  </main>

  <footer class="ftr"><div class="wrap">
    <div class="ftr-inner">
      <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap">
        <a class="brand" href="/"><Fragment set:html={mark} />{c.brand}</a>
        <span class="tag">{c.footerTag}</span>
      </div>
      <div class="meta"><span>Built by <a href="https://ignitemarketing.com">Ignite Marketing</a></span><span>© 2026 {c.brand}</span></div>
    </div>
    <p style="margin-top:20px;color:var(--fg-subtle);font-size:0.76rem;line-height:1.5;max-width:80ch">Early access — features and integrations described are in development and not yet available. Jobber, ServiceTitan, and Housecall Pro are trademarks of their respective owners; {c.brand} is not affiliated with, endorsed by, or partnered with them.</p>
  </div></footer>
</Base>
