---
import '../styles/global.css';
import { content } from '../content';

interface Props { path?: string; }
const { path = '/' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? `https://${content.domain}`;
const url = site + path;
const ogImage = site + '/og.png';
const c = content;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': site + '#org', name: c.brand, url: site, logo: site + '/favicon.svg', description: c.description, sameAs: [] },
    { '@type': 'WebSite', '@id': site + '#web', name: c.brand, url: site, publisher: { '@id': site + '#org' } },
    { '@type': 'Service', name: c.brand, serviceType: c.serviceType, areaServed: 'US', provider: { '@id': site + '#org' },
      description: 'Websites and ongoing local SEO for trades and field-service businesses, wired to Jobber, ServiceTitan, and Housecall Pro.' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#08090c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.brand} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.title} />
    <meta name="twitter:description" content={c.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <style is:inline>:root{--font-display:'Space Grotesk',sans-serif;--font-body:'Inter',system-ui,sans-serif;}</style>
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body>
    <slot />
  </body>
</html>
