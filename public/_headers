# Custom response headers for Cloudflare Workers Static Assets.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Astro copies public/ to dist/ at build time, and this rule file is parsed by
# Workers (not served). HTML keeps the platform default
# (public, max-age=0, must-revalidate) so pages always revalidate.

# Security headers for every static response. Worker-generated responses
# (/api/waitlist) do not pass through this file; worker/index.ts sets its own.
# A full default-src/script-src CSP needs the inline Waitlist module script
# hashed or externalized first (follow-up).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Build output under /_astro/ is content-hashed: a given URL never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable public file names: cache for a day in the browser.
/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
